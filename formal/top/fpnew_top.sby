[tasks]
prf
cvr
bmc

[options]
prf: mode prove
cvr: mode cover
bmc: mode bmc
depth 15

[engines]
smtbmc yices

[script]
verific -sv -DFORMAL \
  fpnew_pkg.sv                    \
  fpnew_classifier.sv             \
  fpnew_rounding.sv               \
  fpnew_cast_multi.sv             \
  cf_math_pkg.sv                  \
  rr_arb_tree.sv                  \
  lzc.sv                          \
  fpnew_fma.sv                    \
  fpnew_fma_multi.sv              \
  fpnew_noncomp.sv                \
  gated_clk_cell.v                 \
  ct_vfdsu_ctrl.v                 \
  ct_vfdsu_top.v                  \
  defs_div_sqrt_mvp.sv            \
  control_mvp.sv                  \
  div_sqrt_mvp_wrapper.sv         \
  div_sqrt_top_mvp.sv             \
  iteration_div_sqrt_mvp.sv       \
  norm_div_sqrt_mvp.sv            \
  nrbd_nrsc_mvp.sv                \
  preprocess_mvp.sv               \
  fpnew_divsqrt_th_32.sv          \
  fpnew_divsqrt_th_64_multi.sv    \
  fpnew_divsqrt_multi.sv          \
  fpnew_opgroup_fmt_slice.sv      \
  fpnew_opgroup_multifmt_slice.sv \
  fpnew_opgroup_block.sv          \
  fpnew_top.sv                    \
  handshake_checker.sv            \
  divsqrt_pulp_hs_bind.sv         \
  cast_hs_bind.sv                 \
  top_bind.sv

verific -import -extnets fpnew_top

prep -top fpnew_top

[files]
fpnew_pkg.sv                     ../../src/fpnew_pkg.sv
fpnew_classifier.sv              ../../src/fpnew_classifier.sv
fpnew_rounding.sv                ../../src/fpnew_rounding.sv
fpnew_cast_multi.sv              ../../src/fpnew_cast_multi.sv
fpnew_fma.sv                     ../../src/fpnew_fma.sv
