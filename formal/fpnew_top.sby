[tasks]
compile

[options]
compile: mode bmc
depth 1
# No 'syntax'-only mode exists in SymbiYosys (only bmc/prove/live/cover).
# There are no properties in this script, so bmc at depth 1 just runs
# read -> prep -> synth -> the solver, trivially PASSes with nothing to
# falsify, but still fails loudly on any read/elaboration error. That's
# the compile-sanity check you're after.

[engines]
smtbmc boolector

[script]
# Order matters: fpnew_pkg first, everything else depends on it.
# Paths below assume you're running `sby` from inside `cvfpu/formal/`
# with the repo checked out one level up. Adjust to your layout.
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_pkg.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_cast_multi.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_classifier.sv

# T-Head E906/C910 divsqrt vendor units (plain Verilog, pulled in by
# fpnew_divsqrt_th_32/64_multi). Drop this block + the two divsqrt_th
# files below if your Implementation config doesn't use PulpDivsqrt=0.
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/clk/rtl/gated_clk_cell.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_ctrl.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_ff1.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_pack_single.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_prepare.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_round_single.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_special.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_srt_single.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fdsu/rtl/pa_fdsu_top.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fpu/rtl/pa_fpu_dp.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fpu/rtl/pa_fpu_frbus.v
read -formal -sv ../vendor/opene906/E906_RTL_FACTORY/gen_rtl/fpu/rtl/pa_fpu_src_type.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_ctrl.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_double.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_ff1.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_pack.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_prepare.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_round.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_scalar_dp.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_srt_radix16_bound_table.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_srt_radix16_with_sqrt.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_srt.v
read -formal -sv ../vendor/openc910/C910_RTL_FACTORY/gen_rtl/vfdsu/rtl/ct_vfdsu_top.v

read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_divsqrt_th_32.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_divsqrt_th_64_multi.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_divsqrt_multi.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_fma.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_fma_multi.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_noncomp.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_opgroup_block.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_opgroup_fmt_slice.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_opgroup_multifmt_slice.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_rounding.sv
read -formal -sv -I ../vendor/common_cells/include ../src/fpnew_top.sv

prep -top fpnew_top

