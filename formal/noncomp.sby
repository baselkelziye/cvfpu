[tasks]
prf
cvr
bmc
[options]
prf: mode prove
cvr: mode cover
bmc: mode bmc
depth 31

[engines]
smtbmc

[script]
plugin -i slang
read_slang -D FORMAL -I . --top fpnew_noncomp       \
                                fpnew_pkg.sv        \
                                fpnew_noncomp.sv    \
                                fpnew_classifier.sv \

prep -top fpnew_noncomp

[files]
fpnew_pkg.sv                ../src/fpnew_pkg.sv
fpnew_noncomp.sv            ../src/fpnew_noncomp.sv
fpnew_classifier.sv         ../src/fpnew_classifier.sv
common_cells/registers.svh  ../src/common_cells/include/common_cells/registers.svh