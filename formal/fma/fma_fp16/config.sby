[options]
mode bmc
depth 6

[engines]
smtbmc z3 -- --logic=ALL

[script]
verific -sv fpnew_pkg.sv fp16_add_rne.sv cf_math_pkg.sv lzc.sv fp16_classify.sv fpnew_rounding.sv fmalza.sv fpnew_fma_multi.sv fpnew_fma.sv handshake_checker.sv fpnew_classifier.sv tb_fma.sv
verific -sv -DFORMAL -DFP16 -DRNE -DADD

prep -top tb_fma
[files]
fpnew_pkg.sv        ../../src/fpnew_pkg.sv
common_cells/registers.svh       ../../src/common_cells/include/common_cells/registers.svh
fpnew_classifier.sv ../../src/fpnew_classifier.sv
fpnew_rounding.sv                ../../src/fpnew_rounding.sv
fmalza.sv           ../../vendor/cvw/fma/fmalza.sv
handshake_checker.sv             ../fv_common/handshake_checker.sv
lzc.sv              ../../src/common_cells/src/lzc.sv
cf_math_pkg.sv      ../../src/common_cells/src/cf_math_pkg.sv
fpnew_fma_multi.sv  ../../src/fpnew_fma_multi.sv
fpnew_fma.sv  ../../src/fpnew_fma.sv
fp16_add_rne.sv
fp16_classify.sv
tb_fma.sv
